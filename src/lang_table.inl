    {"за перегородкой: He %d из %d (%.0f%%), Ar %d из %d (%.0f%%) · скорость эффузии He/Ar = %s · закон Грэма √(mAr/mHe) = %.2f", "past the partition: He %d of %d (%.0f%%), Ar %d of %d (%.0f%%) · effusion rate He/Ar = %s · Graham's law √(mAr/mHe) = %.2f"},
    {"перешеек %.1fσ (%.1f нм) · центры сблизились на %.2fσ · Au в «чужой» половине %.0f%%, Ag %.0f%% · T = %.2f", "neck %.1fσ (%.1f nm) · centers closer by %.2fσ · Au in the \"other\" half %.0f%%, Ag %.0f%% · T = %.2f"},
    {"газ в равновесии с поршнем: V = %.0fσ%s, T = %.2f (%.0f K); с 2τ давление начнёт расти", "gas in equilibrium with the piston: V = %.0fσ%s, T = %.2f (%.0f K); the pressure starts rising at 2τ"},
    {"V0/V = %.2f · T/T0 = %.2f (T = %.0f K) · адиабата (V0/V)^(γ−1) = %.2f при γ = %.2f · P внешн. = %.3f", "V0/V = %.2f · T/T0 = %.2f (T = %.0f K) · adiabat (V0/V)^(γ−1) = %.2f at γ = %.2f · P ext. = %.3f"},
    {"угол смачивания θ ≈ %.0f° (основание %.1fσ, высота %.1fσ) · притяжение стенки %.2f → %s", "contact angle θ ≈ %.0f° (base %.1fσ, height %.1fσ) · wall attraction %.2f → %s"},
    {"смачивает (θ < 90°)", "wets (θ < 90°)"},
    {"не смачивает (θ > 90°)", "does not wet (θ > 90°)"},
    {"доля кристалла %.0f%% · жидкость %.0f%% · затравка %d атомов (закреплена) · T = %.3f (%.0f K)", "crystal fraction %.0f%% · liquid %.0f%% · seed of %d atoms (pinned) · T = %.3f (%.0f K)"},
    {"скорость потока: в центре %.3f, у стенок %.3f σ/τ (%.0f и %.0f м/с) · средняя / максимальная = %.2f (парабола Пуазейля: 0.67)", "flow speed: center %.3f, at the walls %.3f σ/τ (%.0f and %.0f m/s) · mean / max = %.2f (Poiseuille parabola: 0.67)"},
    {"жидкость ρ = %.3f (модель %.3f) · пар ρ = %.4f (модель %.4f) · T = %.3f (%.0f K) · давление пара %.3f бар", "liquid ρ = %.3f (model %.3f) · vapor ρ = %.4f (model %.4f) · T = %.3f (%.0f K) · vapor pressure %.3f bar"},
    {"на стенках %d атомов, в газе %d · покрытие θ = %.0f%% монослоя · давление газа %.4f (%.0f бар) · притяжение стенок %.2f", "on the walls %d atoms, in the gas %d · coverage θ = %.0f%% of a monolayer · gas pressure %.4f (%.0f bar) · wall attraction %.2f"},
