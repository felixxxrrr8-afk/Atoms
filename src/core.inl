enum { E_AR, E_NE, E_H, E_C, E_N, E_O, E_NA, E_CL, E_CLM, E_BIG, E_WALL, E_FIRSTX };
constexpr int NEL = E_FIRSTX + 111;   // + все элементы, которых нет среди настроенных (118 − 7)
// категории для таблицы Менделеева
