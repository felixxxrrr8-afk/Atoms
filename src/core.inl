                                  "неметалл", "галоген", "благородный газ", "лантаноид", "актиноид", "особый тип"};
struct Element {
    const char* sym; const char* name;
    double m, sig, eps, fq;  // масса (10 а.е.м.), σ, ε, формальный заряд
    int val;                 // валентность
