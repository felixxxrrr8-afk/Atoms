static inline bool zpEstimated(int Z) { return Z == 85 || Z == 87 || Z >= 99; }
// группа (1–18; 0 — лантаноиды и актиноиды) и период по номеру Z
static void zGroupPeriod(int Z, int& grp, int& per) {
    static const int P0[8] = {0, 2, 10, 18, 36, 54, 86, 118};
    per = 1; while (per < 7 && Z > P0[per]) per++;
    const int k = Z - P0[per - 1];   // место в периоде, с 1
    if (per == 1) grp = Z == 1 ? 1 : 18;
    else if (per <= 3) grp = k <= 2 ? k : k + 10;
    else if (per <= 5) grp = k;
    else grp = k <= 2 ? k : (k <= 16 ? 0 : k - 14);   // 6–7 период: La…Yb / Ac…No (k = 3…16) — f-блок; Lu, Lr — 3-я группа
}
// электронная конфигурация основного состояния: правило Клечковского + известные исключения; [остов благородного газа]
static std::string zElectronConfig(int Z) {
    static const int ON[19] = {1, 2, 2, 3, 3, 4, 3, 4, 5, 4, 5, 6, 4, 5, 6, 7, 5, 6, 7};   // n подоболочек в порядке заполнения
    static const int OL[19] = {0, 0, 1, 0, 1, 0, 2, 1, 0, 2, 1, 0, 3, 2, 1, 0, 3, 2, 1};   // l
    int occ[8][4] = {};
    for (int e = Z, i = 0; e > 0 && i < 19; i++) { int c = std::min(e, 4 * OL[i] + 2); occ[ON[i]][OL[i]] = c; e -= c; }
    auto mv = [&](int n1, int l1, int n2, int l2, int c) { occ[n1][l1] -= c; occ[n2][l2] += c; };   // c электронов из n1l1 в n2l2
    switch (Z) {
    case 24: case 29: mv(4, 0, 3, 2, 1); break;
    case 41: case 42: case 44: case 45: case 47: mv(5, 0, 4, 2, 1); break;
    case 46: mv(5, 0, 4, 2, 2); break;
    case 78: case 79: mv(6, 0, 5, 2, 1); break;
    case 57: case 58: case 64: mv(4, 3, 5, 2, 1); break;
    case 89: case 91: case 92: case 93: case 96: mv(5, 3, 6, 2, 1); break;
    case 90: mv(5, 3, 6, 2, 2); break;
    case 103: mv(6, 2, 7, 1, 1); break;
    }
    static const int NG[6] = {2, 10, 18, 36, 54, 86}; static const char* NGS[6] = {"[He]", "[Ne]", "[Ar]", "[Kr]", "[Xe]", "[Rn]"};
    int core = -1; for (int k = 0; k < 6; k++) if (NG[k] < Z) core = k;
    int left[8][4]; memcpy(left, occ, sizeof(occ));
    if (core >= 0) for (int e = NG[core], i = 0; e > 0 && i < 19; i++) { int c = std::min(e, 4 * OL[i] + 2); left[ON[i]][OL[i]] -= c; e -= c; }
    static const char* SUP[10] = {"⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"};
    std::string s = core >= 0 ? NGS[core] : "";
    for (int n = 1; n <= 7; n++) for (int l = 0; l < 4; l++) if (left[n][l] > 0) {
        if (!s.empty()) s += ' ';
        s += std::to_string(n); s += "spdf"[l];
        int c = left[n][l]; if (c >= 10) s += SUP[c / 10]; s += SUP[c % 10];
    }
    return s;
}
// ---- Валентность по счёту электронов. У атома главной подгруппы VE валентных электронов; каждая ковалентная связь
// берёт один, остальные — неподелённые пары и неспаренные электроны. Элементы 2-го периода держат не больше 8 электронов
// (октет), начиная с 3-го периода у p-элементов октет расширяется до 12–14 (SF6, PCl5, ClF3, XeF4): неподелённая пара
// «распаривается» и даёт ещё две связи, но только с электроотрицательными соседями (F, O, Cl, N) и с потерей энергии
// на промотирование электрона (EPROM на каждую связь сверх обычной валентности).
static int VE[NEL];          // валентные электроны (номер группы для главных подгрупп; у переходных — обычная валентность)
static bool HYPER[NEL];      // может расширять октет
static double EPROM[NEL];    // энергия каждой связи сверх обычной валентности, ε
static inline int valMax(int t) { return HYPER[t] ? std::max(EL[t].val, std::min(VE[t], 14 - VE[t])) : EL[t].val; }
static void initValence() {
    for (int t = 0; t < NEL; t++) {
        const int Z = EL[t].Z; VE[t] = EL[t].val; HYPER[t] = false; EPROM[t] = 0;
        if (Z < 1 || Z > 118 || EL[t].fixed) continue;
        int grp, per; zGroupPeriod(Z, grp, per);
        if (grp == 1 || grp == 2) VE[t] = grp;
        else if (grp >= 13) VE[t] = grp - 10;
        HYPER[t] = per >= 3 && grp >= 14 && Z != 18;   // Si, P, S, Cl, Ge, As, Se, Br, Kr, Sn, Sb, Te, I, Xe…
        double e = 1.0;   // эВ: по теплотам образования SF2 → SF4 → SF6, PF3 → PF5, ClF → ClF3, XeF2 → XeF4 (NIST)
        switch (Z) { case 16: e = 0.2; break; case 34: case 52: e = 0.3; break; case 15: case 33: e = 1.3; break; case 51: e = 0.8; break;
                     case 17: e = 1.2; break; case 35: e = 1.0; break; case 53: e = 0.7; break; case 54: e = 1.3; break; case 36: e = 2.0; break; }
        EPROM[t] = e * cfg::EV;
    }
}
static int TZ[119];                       // тип частицы для элемента с номером Z
static int E_F = -1;                      // тип фтора (донор/акцептор водородной связи)
static inline bool isRadioactive(int Z) { return Z == 43 || Z == 61 || Z >= 84; }
static inline bool metalCat(int c) { return c == CAT_ALK || c == CAT_AE || c == CAT_TM || c == CAT_PTM || c == CAT_LAN || c == CAT_ACT; }
// ван-дер-ваальсовы параметры благородных газов (литература): σ (Å), ε (K)
static bool nobleLJ(int Z, double& sA, double& eK) {
    switch (Z) { case 2: sA = 2.556; eK = 10.22; return true; case 36: sA = 3.636; eK = 166.7; return true; case 54: sA = 3.961; eK = 231.0; return true;
                 case 86: sA = 4.17; eK = 300.0; return true; case 118: sA = 4.40; eK = 350.0; return true; }
    return false;
}
static void initElements() {
    // настроенные типы: только номер, категория и радиусы из таблицы
    const int known[][2] = {{E_AR, 18}, {E_NE, 10}, {E_H, 1}, {E_C, 6}, {E_N, 7}, {E_O, 8}, {E_NA, 11}, {E_CL, 17}, {E_CLM, 17}};
    for (int z = 0; z <= 118; z++) TZ[z] = -1;
    for (auto& k : known) {
        Element& e = EL[k[0]]; const ZData& d = ZD[k[1]];
        e.Z = k[1]; e.cat = d.cat; e.rcov = d.rcov; e.dAA = d.dAA; e.metal = false;
        if (k[0] != E_NA && k[0] != E_CLM) TZ[k[1]] = k[0];
    }
    EL[E_NA].cat = CAT_SPECIAL; EL[E_CLM].cat = CAT_SPECIAL;   // ионы — отдельные типы
    int t = E_FIRSTX;
    for (int z = 1; z <= 118; z++) {
        if (TZ[z] >= 0) continue;
        const ZData& d = ZD[z]; Element& e = EL[t];
        e.sym = d.sym; e.name = d.name; e.m = d.mass / 10.0; e.fq = 0; e.val = d.val; e.chi = d.cat == CAT_NOB ? 0 : d.chi;
        if (z == 36) e.chi = 3.00; else if (z == 54) e.chi = 2.60; else if (z == 86) e.chi = 2.20;   // тяжёлые благородные газы образуют фториды и оксиды
        e.r = ((d.rgb >> 16) & 255) / 255.0f; e.g = ((d.rgb >> 8) & 255) / 255.0f; e.b = (d.rgb & 255) / 255.0f;
        // тёмные цвета Jmol плохо видны на тёмном фоне — поднимаем яркость
        float lum = 0.3f * e.r + 0.59f * e.g + 0.11f * e.b;
        if (lum < 0.42f) { float k = (0.42f - lum) / (1.0f - lum); e.r += (1 - e.r) * k; e.g += (1 - e.g) * k; e.b += (1 - e.b) * k; }
        e.rcf = 2.5; e.fixed = false;
        e.Z = z; e.cat = d.cat; e.metal = metalCat(d.cat); e.rcov = d.rcov; e.rmet = e.metal ? d.rsig : 0; e.ecoh = d.ecoh; e.dAA = d.dAA;
        double sA, eK;
        if (nobleLJ(z, sA, eK)) { e.sig = sA / 3.405; e.eps = eK / 119.8; }
        else {
            e.sig = 2 * d.rsig / 1.1225 / 3.405;          // минимум LJ на расстоянии 2·r_σ
            e.eps = e.metal ? std::max(0.3, d.eps) : d.eps;   // металлам — ощутимое отталкивающее ядро с неметаллами
        }
        TZ[z] = t++;
    }
    if (t != NEL) { MessageBoxW(nullptr, TW("Внутренняя ошибка: неверное число типов элементов").c_str(), TW("Атомы").c_str(), MB_ICONERROR); ExitProcess(3); }
    E_F = TZ[9];
}
static inline int typeOfZ(int z) { return z >= 1 && z <= 118 ? TZ[z] : -1; }

// Таблица связей: энергии диссоциации по порядку связи (эВ → ε), длины (Å → σ_Ar) и ширина ямы Морзе a (1/σ).
// a = ω·√(μ/2D) — по частоте колебаний: тогда кривизна ямы 2Da² даёт реальную частоту связи.
struct BondT { double D[4] = {0, 0, 0, 0}; double r0[4] = {0, 0, 0, 0}; double a[4] = {0, 0, 0, 0}; int maxOrder = 0; };
static BondT BT[NEL][NEL];
// a — в Å⁻¹ по порядкам связи (пустой список — 2.0 Å⁻¹, у кратных связей яма чуть уже)
static void setBond(int a, int b, std::initializer_list<double> Dev, std::initializer_list<double> rA, std::initializer_list<double> aA = {}) {
    BondT t; int o = 1;
    auto ri = rA.begin(); auto ai = aA.begin();
    for (double d : Dev) {
        t.D[o] = d * cfg::EV; t.r0[o] = (*ri) / 3.405;
        t.a[o] = (ai != aA.end() ? *ai++ : 2.0 + 0.15 * (o - 1)) * 3.405;
        ++ri; t.maxOrder = o; ++o;
    }
    BT[a][b] = t; BT[b][a] = t;
}
// элементы, образующие кратные связи (π-связи): B, C, N, O, Si, P, S, Ge, As, Se
static inline bool multiBonder(int Z) { return Z == 5 || Z == 6 || Z == 7 || Z == 8 || Z == 14 || Z == 15 || Z == 16 || Z == 32 || Z == 33 || Z == 34; }
// Общее правило для любой пары элементов (если связь не задана явно):
//   энергия — по Полингу: D_AB = ½(D_AA + D_BB) + min(Δχ², 2.5) эВ (ионный вклад ограничен);
//   длина — по Шомакеру–Стивенсону: r_AB = r_A + r_B − 0.09·|Δχ| Å;
//   кратные связи (только у B, C, N, O, Si, P, S, Ge, As, Se): D₂ ≈ 1.75·D₁, D₃ ≈ 2.4·D₁, связь короче на 0.20 и 0.34 Å.
// Металл–металл ковалентно не связываются (у них металлическая связь), благородные газы и ионы — инертны.
static void genericBonds() {
    for (int a = 0; a < NEL; a++) for (int b = a; b < NEL; b++) {
        const Element &A = EL[a], &B = EL[b];
        if (A.val <= 0 || B.val <= 0 || A.fixed || B.fixed || A.Z == 0 || B.Z == 0 || (A.metal && B.metal)) { BT[a][b] = BT[b][a] = BondT(); continue; }
        double dchi = std::fabs(A.chi - B.chi);
        double D1 = std::max(0.3, 0.5 * (A.dAA + B.dAA) + std::min(dchi * dchi, 2.5));
        double r1 = A.rcov + B.rcov - 0.09 * dchi;
        int mo = (multiBonder(A.Z) && multiBonder(B.Z)) ? std::min(3, std::min(A.val, B.val)) : 1;
        const double kD[4] = {0, 1.0, 1.75, 2.4}, dr[4] = {0, 0, 0.20, 0.34};
        // ширина ямы: ковалентная связь ≈ 2 Å⁻¹, ионная (большая разность χ) шире и мягче — у молекулы NaCl 1.0 Å⁻¹
        const double aw = std::max(1.0, 2.0 - 0.4 * std::max(0.0, dchi - 1.0));
        BondT t; t.maxOrder = mo;
        for (int o = 1; o <= mo; o++) { t.D[o] = D1 * kD[o] * cfg::EV; t.r0[o] = (r1 - dr[o]) / 3.405; t.a[o] = (aw + 0.15 * (o - 1)) * 3.405; }
        BT[a][b] = t; BT[b][a] = t;
    }
}
static void initChemTables();   // chemistry.inl: справочные энергии и длины связей для конкретных пар
static void initBondTable() {
    initElements();
    initValence();
    genericBonds();     // сначала общее правило для любой пары,
    initChemTables();   // затем реальные значения там, где они известны
}

// ===================================== RNG / utils =====================================
static std::mt19937_64 rng(12345);
static inline double urand() { return std::uniform_real_distribution<double>(0.0, 1.0)(rng); }
static inline double grand() { return std::normal_distribution<double>(0.0, 1.0)(rng); }
template <class T> static inline T clampv(T v, T a, T b) { return v < a ? a : (v > b ? b : v); }
// форматирование строки (как printf); строка формата переводится (lang.inl: спецификаторы в переводе те же)
static std::string fmt(const char* f, ...) {
    const char* tf = LANG == LANG_RU ? nullptr : langFind(f, strlen(f), "fmt");
    char buf[1024]; va_list ap; va_start(ap, f); vsnprintf(buf, sizeof(buf), tf ? tf : f, ap); va_end(ap); return buf;
}

