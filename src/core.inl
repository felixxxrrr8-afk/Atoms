    double dt = cfg::DT_LJ, dtBase = cfg::DT_LJ;
    int thermostat = TH_BERENDSEN, boundary = B_PERIODIC;
    bool npt = false;
    int heatWalls = 0;            // 0 нет, 1 слева горячая/справа холодная, 2 горячее дно
    double Thot = 2.0, Tcold = 0.3;
    bool catalyst = false; double catX = 0, catY = 0, catZ = 0, catR = 6;
    double tauT = 0.5, tauP = 3.0;
    bool chemistry = true;
    bool paused = false;
    double efield = 0;            // внешнее электрическое поле вдоль x (ε/(σ·e))
    double eaScale = 1.0;         // множитель кинетических барьеров реакций
    bool acidBase = true;         // кислотно-основные реакции: перенос протона (H3O+, OH−, NH4+, HCl → Cl−)
    bool surfCat = true;          // металлическая поверхность (Pt, Pd, Ni, Fe…) снижает барьеры адсорбированных молекул
} P;

// ---- Объекты поля: постоянные «приборы», которые пользователь ставит в ящик (общий интерфейс UI ↔ физика).
//  Физика (physics.inl) применяет их в computeForces/mdStep; UI (ui.inl/app.inl) ставит, двигает, рисует, удаляет.
enum { FO_ATTRACT, FO_REPEL, FO_HEATER, FO_COOLER, FO_WIND, FO_VORTEX, FO_TRAP, FO_EMITTER, FO_SINK, FO_BARRIER, FO_N };
struct FieldObj {
    int kind = FO_ATTRACT;
    double x = 0, y = 0, z = 0;       // центр (для FO_BARRIER — первый конец отрезка/пластины)
    double x2 = 0, y2 = 0, z2 = 0;    // FO_BARRIER: второй конец; FO_WIND: не используется
    double R = 4;                     // радиус действия
    double strength = 1;              // сила / мощность / темп (смысл зависит от вида)
    double dx = 1, dy = 0, dz = 0;    // направление (FO_WIND, FO_EMITTER)
    double Tset = 2.0;                // FO_HEATER/FO_COOLER: целевая температура зоны
    int elem = 0;                     // FO_EMITTER: тип атомов (индекс EL)
    double acc = 0;                   // FO_EMITTER: накопитель испускания
    bool on = true;
    // измеряется физикой (только для показа): мощность теплообмена зоны (ε/τ, + — нагрев) или
    // темп испускания/поглощения (атомов/τ); cnt — всего испущено/поглощено атомов
    double pw = 0; long long cnt = 0;
    double ramp = 0;                  // плавное включение 0 → 1 за ~1τ (ведёт физика; выключенный объект — 0)
    bool fromPreset = false;          // поставлен пресетом сцены: при сбросе пересоздаётся (объекты пользователя переносятся)
};
static std::vector<FieldObj> fieldObjs;
static int selFieldObj = -1;          // выбранный объект (UI)

static inline bool isPer() { return P.boundary == B_PERIODIC; }
static double boxVolume() { return S.Lx * S.Ly * S.Lz; }
static double wallArea() { return 2 * (S.Lx * S.Ly + S.Ly * S.Lz + S.Lx * S.Lz); }
static double pistonArea() { return S.Lx * S.Lz; }

