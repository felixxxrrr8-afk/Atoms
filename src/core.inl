    float r, g, b;           // цвет CPK
    double rcf;              // обрезка LJ в σ_ij (2.5 — с притяжением, 1.122 — только отталкивание WCA)
    bool fixed;
    // заполняются в initElements()
    int Z = 0, cat = CAT_SPECIAL; bool metal = false;
    double rcov = 0, rmet = 0, ecoh = 0, dAA = 0;   // ковалентный радиус (Å), металлический радиус (Å), энергия когезии и связи A–A (эВ)
